{
  // Local Pages Functions preview only. Production deploys through the Pages Git integration.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "about",
  "main": "worker.js",
  "compatibility_date": "2026-06-13",
  "workers_dev": true,
  "preview_urls": true,
  // Daily site_events cleanup at 00:00 China Standard Time (16:00 UTC;
  // Cloudflare Cron runs in UTC). The scheduled() handler in worker.js only
  // deletes rows older than the 90-day retention cutoff.
  "triggers": {
    "crons": ["0 16 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "COMMENTS_KV",
      "id": "f7c63320decb47d584bb78fbd6144167"
    }
  ],
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "about-comments",
      "database_id": "08bd311d-0959-43d6-aa00-00582300beb1"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "COMMENT_MODERATION_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADnuEH7YMTYy_Dgd",
    "RUNTIME_SCHEMA_BOOTSTRAP": "1"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
